{
  "name": "bitestream-backend",
  "version": "1.0.0",
  "description": "Real-time food delivery management backend powered by Express, MongoDB Geospatial Indexing, MongoDB Change Streams, and Socket.IO",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seedDatabase.js",
    "seed:demo": "node src/seed/seedDatabase.js --with-orders",
    "exp:geo": "node scripts/experiments/benchmarkGeo.js",
    "exp:realtime": "node scripts/experiments/benchmarkChangeStreams.js"
  },
  "keywords": [
    "mongodb",
    "geospatial",
    "change-streams",
    "socket.io",
    "food-delivery",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  }
}
