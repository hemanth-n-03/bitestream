# Server Configuration
NODE_ENV=development
PORT=5000

# Client Origin (CORS & Socket.IO)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection (Configure in Phase 4 - Database Integration)
# Must point to a replica-set-capable cluster for MongoDB Change Streams
MONGODB_URI=your_mongodb_atlas_connection_string_here
DB_NAME=bitestream

# Authentication (JWT)
JWT_SECRET=replace_with_a_long_random_64_char_secret_key
JWT_EXPIRES_IN=7d

# Operational Tuning
GPS_DB_WRITE_INTERVAL_MS=5000
MAX_DELIVERY_SEARCH_RADIUS_METERS=10000
DELIVERY_RADIUS_STEPS_METERS=3000,6000,10000
ASSIGNMENT_OFFER_TIMEOUT_MS=45000
